# Web app (apps/web/.env.local)
# Supabase — Project Settings → API in the Supabase dashboard, or `supabase status` locally
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated profile IDs that can use the moderation queue
ADMIN_PROFILE_IDS=

# Rate limiting (Upstash Redis — get from upstash.com). Without these, a per-process limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: only needed if "enhanced push security" is turned on for the Expo project
EXPO_ACCESS_TOKEN=

# Optional: contact address shown on the Privacy and Terms pages (defaults to socialolympics.app@protonmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# Mobile app (apps/mobile/.env locally; EAS environment variables for builds)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The deployed web app, which also serves the API (local: http://<your-computer-ip>:3000)
EXPO_PUBLIC_API_BASE_URL=
# Optional: where sign-up confirmation links land (defaults to <API base URL>/api/auth/callback)
EXPO_PUBLIC_AUTH_REDIRECT_URL=
