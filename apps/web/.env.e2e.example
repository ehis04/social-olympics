# Local-only E2E environment — copy to .env.e2e and fill in values from `pnpm db:start`
# Never use production credentials or commit .env.e2e to version control.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
SUPABASE_SERVICE_ROLE_KEY=<local service role key>
ADMIN_PROFILE_IDS=<local admin profile UUID>

# Test user (competitor role)
E2E_USER_EMAIL=competitor@example.com
E2E_USER_PASSWORD=your-password
E2E_USER_DISPLAY_NAME=Competitor

# Host user (host role in test competition)
E2E_HOST_EMAIL=host@example.com
E2E_HOST_PASSWORD=your-password

# IDs for tests that need pre-created local data
E2E_COMPETITION_ID=your-competition-uuid
E2E_EVENT_ID=your-event-uuid
E2E_PROFILE_ID=your-profile-uuid
E2E_OTHER_PROFILE_ID=another-profile-uuid
E2E_GHOST_PROFILE_ID=your-ghost-profile-uuid
E2E_COMPLETED_COMPETITION_ID=your-completed-competition-uuid

# Optional: override base URL (defaults to http://localhost:3000)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
