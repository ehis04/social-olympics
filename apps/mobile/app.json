{
  "expo": {
    "name": "Social Olympics",
    "slug": "social-olympics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.socialolympics.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.socialolympics.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon.png",
          "color": "#2D6A4F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Social Olympics to use your camera to scan competition QR codes and take evidence photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Social Olympics to access your photos so you can add a profile photo or evidence for a result.",
          "cameraPermission": "Allow Social Olympics to use your camera to take evidence photos for your results.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "scheme": "socialolympics",
    "extra": {
      "eas": {
        "projectId": "f8b71a58-11fb-4d91-90ff-b988696ad623"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "ehisoghinas-organization"
  }
}
